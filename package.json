{
  "name": "taiwan-mandarin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run src",
    "test:e2e": "playwright test",
    "content:check": ".venv\\Scripts\\python.exe -m backend.content",
    "server": ".venv\\Scripts\\python.exe -m backend.launcher --no-browser",
    "build:mobile": "tsc --noEmit -p mobile/tsconfig.json && vite build --config vite.mobile.config.ts",
    "android:build": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/Build-Android.ps1",
    "android:install": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/Install-Android.ps1"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/barcode-scanner": "3.1.3",
    "@capacitor/core": "8.6.0",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "ts-fsrs": "5.4.2"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "@playwright/test": "1.63.0",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
